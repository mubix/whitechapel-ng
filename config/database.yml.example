# Whitechapel requires PostgreSQL (hash search uses pg_search).
default: &default
  adapter: postgresql
  encoding: unicode
  host: <%= ENV["DATABASE_HOST"] || "localhost" %>
  username: <%= ENV["DATABASE_USERNAME"] || "whitechapel" %>
  password: <%= ENV["DATABASE_PASSWORD"] || "whitechapel" %>
  pool: <%= ENV.fetch("RAILS_MAX_THREADS") { 5 } %>

development:
  <<: *default
  database: whitechapel_ng_dev

test:
  <<: *default
  database: whitechapel_ng_test

production:
  <<: *default
  database: <%= ENV["DATABASE_NAME"] || "whitechapel_ng_production" %>
